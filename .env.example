# Copy this file to .env and adjust as needed. It is only loaded if you
# uncomment the `env_file: .env` line in docker-compose.yml.

LISTEN_ADDR=:8080
DATA_DIR=/data
BASE_URL=http://localhost:8080
ALLOW_SIGNUP=true
COOKIE_SECURE=false
TRUST_PROXY_HEADERS=false

# Optional: enable password-reset emails. Leave SMTP_HOST empty to disable
# email and rely on `koserver gen-reset-link -username <name>` instead.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=koreader-sync@example.com
SMTP_STARTTLS=true

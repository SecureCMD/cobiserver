# Installed by `make install` to /etc/koserver/koserver.env (only if that
# file doesn't already exist — re-running install never overwrites your
# edits). Loaded by the systemd unit via EnvironmentFile=-. See README.md
# for the full list of variables.

LISTEN_ADDR=:8080
DATA_DIR=/var/lib/koserver
BASE_URL=http://localhost:8080
ALLOW_SIGNUP=true
COOKIE_SECURE=false
TRUST_PROXY_HEADERS=false

# Optional: enable password-reset emails. Leave SMTP_HOST empty to rely on
# `koserver gen-reset-link -username <name>` instead.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=koreader-sync@example.com
SMTP_STARTTLS=true

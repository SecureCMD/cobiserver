#!/usr/bin/make -f

export CGO_ENABLED = 0
# Dependencies are vendored (vendor/, committed), so the build never
# touches the network; -mod=vendor makes that mandatory rather than an
# implicit default. It does NOT help with the separate golang-go version
# requirement below - vendoring avoids network fetches, not the need for
# a new enough `go` binary to compile this module in the first place.
export GOFLAGS = -mod=vendor

VERSION := $(shell dpkg-parsechangelog -SVersion)
COMMIT  := $(shell git rev-parse --short HEAD 2>/dev/null || echo none)
DATE    := $(shell date -u +%Y-%m-%dT%H:%M:%SZ)
LDFLAGS := -s -w -X main.version=$(VERSION) -X main.commit=$(COMMIT) -X main.date=$(DATE)

%:
	dh $@ --with installsysusers

override_dh_auto_build:
	go build -trimpath -ldflags "$(LDFLAGS)" -o bin/koserver ./cmd/koserver

override_dh_auto_test:
	go test ./...

override_dh_auto_install:
	install -Dm0755 bin/koserver debian/koserver/usr/bin/koserver
	install -Dm0640 packaging/systemd/koserver.env.example debian/koserver/etc/koserver/koserver.env

override_dh_auto_clean:
	dh_auto_clean
	rm -rf bin
